{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".github/**", "CHANGELOG.md", ".wxt/**", ".output/**", "node_modules/**"],
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "useTabs": false,
  "semi": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  }
}
